{
    "name": "psc-acme/engine-shipping",
    "description": "Package engine-shipping for psc-acme organization",
    "type": "library",
    "license": "MIT",
    "authors": [
        {
            "name": "Philipp Scheit",
            "email": "p.scheit@packagist.com"
        }
    ],
    "autoload": {
        "psr-4": {
            "PscAcme\\EngineShipping\\": "src/"
        }
    },
    "require": {
        "php": ">=8.3",
        "symfony/process": "^7.0",
        "illuminate/database": "^11.0",
        "monolog/monolog": "^3.2.0",
        "symfony/serializer": "^7.0",
        "symfony/cache": "^7.0",
        "psc-acme/formatter-product": "^1.0",
        "psc-acme/provider-cart": "^1.0"
    },
    "require-dev": {
        "friendsofphp/php-cs-fixer": "^3.0"
    },
    "minimum-stability": "stable",
    "config": {
        "secure-http": false
    },
    "repositories": {
        "private-packagist": {
            "type": "composer",
            "url": "http://repo.packagist.com.lo/psc-acme/"
        },
        "packagist.org": false
    }
}